{
  "name": "next-train-app",
  "version": "2.5.7",
  "description": "Shows when to leave for your next train",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:mac": "node scripts/setup-mac.mjs",
    "start": "node dev-server.js",
    "dev": "node dev-server.js",
    "vercel:dev": "vercel dev",
    "build:ads": "esbuild web-sources/ads-native.mjs --bundle --format=iife --global-name=NextTrainAdsNative --outfile=public/ads-bundle.js --platform=browser --external:@capacitor/core",
    "build:ad-free": "esbuild web-sources/ad-free-native.mjs --bundle --format=iife --global-name=NextTrainAdFreeNative --outfile=public/ad-free-bundle.js --platform=browser --external:@capacitor/core",
    "build:train-times": "esbuild web-sources/train-times-client.mjs --bundle --format=iife --global-name=NextTrainTimes --outfile=public/train-times-bundle.js --platform=browser",
    "build:geo": "esbuild web-sources/geo-native.mjs --bundle --format=iife --global-name=NextTrainGeo --outfile=public/geo-bundle.js --platform=browser --external:@capacitor/core",
    "build:analytics": "esbuild web-sources/analytics-native.mjs --bundle --format=iife --global-name=NextTrainAnalyticsNative --outfile=public/analytics-bundle.js --platform=browser --external:@capacitor/core",
    "export:icon": "node store-assets/export-locked-icon.mjs",
    "cap:sync": "node scripts/write-city-directions.mjs && npm run build:ads && npm run build:ad-free && npm run build:train-times && npm run build:geo && npm run build:analytics && npx cap sync android && node scripts/prune-ship-assets.mjs",
    "cap:sync:ios": "node scripts/write-city-directions.mjs && npm run build:ads && npm run build:ad-free && npm run build:train-times && npm run build:geo && npm run build:analytics && npx cap sync ios && node scripts/patch-ios-package-classlist.mjs && node scripts/prune-ship-assets.mjs",
    "cap:open": "set \"CAPACITOR_ANDROID_STUDIO_PATH=C:\\Program Files\\Android\\Android Studio1\\bin\\studio64.exe\" && npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "test:smoke": "node qa/run-all.mjs --smoke",
    "test:pin": "node qa/run-all.mjs --pin",
    "test:web": "node qa/run-all.mjs",
    "test:web:ci": "node qa/run-all.mjs --no-native",
    "test:web:release": "node qa/run-all.mjs --release",
    "test:full": "node qa/run-all.mjs",
    "test:android:unit": "node qa/run-android-unit.mjs",
    "test:android:widget": "node qa/run-android-unit.mjs --widget",
    "test:maestro": "node qa/run-maestro.mjs",
    "test:ios:preflight": "node qa/check-ios-test-setup.mjs",
    "test:ios:maestro": "node qa/run-ios-maestro.mjs",
    "test:pre-upload": "node qa/pre-upload-check.mjs",
    "release:prep": "node qa/release-prep.mjs",
    "test:patch-ship": "node qa/patch-ship-gate.mjs",
    "test:pre-release": "node qa/pre-release.mjs",
    "soak:status": "node qa/soak-status.mjs",
    "probe:brisbane": "node scripts/probe-brisbane-board.mjs",
    "sweep:brisbane": "node qa/brisbane-network-sweep.mjs",
    "dogfood:origin": "node scripts/write-dogfood-origin.mjs",
    "android:debug": "npm run cap:sync && node scripts/assemble-debug.mjs",
    "android:bundle": "npm run cap:sync && node scripts/assemble-release-bundle.mjs",
    "trim:brisbane-gtfs": "node scripts/trim-brisbane-gtfs.mjs",
    "build:line-map": "node scripts/build-line-map.mjs --city=brisbane",
    "probe:sydney": "node scripts/probe-sydney-board.mjs",
    "sweep:sydney": "node qa/sydney-network-sweep.mjs",
    "sweep:uk-london-tfl": "node qa/uk-london-tfl-network-sweep.mjs",
    "trim:sydney-gtfs": "node scripts/trim-sydney-gtfs.mjs",
    "probe:melbourne": "node scripts/probe-melbourne-board.mjs",
    "probe:adelaide": "node scripts/probe-adelaide-board.mjs",
    "probe:uk": "node scripts/probe-uk-board.mjs",
    "probe:uk-london-tfl": "node scripts/probe-uk-london-tfl-board.mjs",
    "sweep:adelaide": "node qa/adelaide-network-sweep.mjs",
    "probe:canberra": "node scripts/probe-canberra-board.mjs",
    "probe:auckland": "node scripts/probe-auckland-board.mjs",
    "probe:wellington": "node scripts/probe-wellington-board.mjs",
    "probe:stockholm": "node scripts/probe-stockholm-board.mjs",
    "probe:amsterdam": "node scripts/probe-amsterdam-board.mjs",
    "probe:rotterdam": "node scripts/probe-rotterdam-board.mjs",
    "probe:vancouver": "node scripts/probe-vancouver-board.mjs",
    "probe:gold-coast": "node scripts/probe-gold-coast-board.mjs",
    "probe:newcastle": "node scripts/probe-newcastle-board.mjs",
    "sweep:auckland": "node qa/auckland-network-sweep.mjs",
    "sweep:wellington": "node qa/wellington-network-sweep.mjs",
    "sweep:stockholm": "node qa/stockholm-network-sweep.mjs",
    "sweep:amsterdam": "node qa/amsterdam-network-sweep.mjs",
    "sweep:rotterdam": "node qa/rotterdam-network-sweep.mjs",
    "sweep:vancouver": "node qa/vancouver-network-sweep.mjs",
    "sweep:canberra": "node qa/canberra-network-sweep.mjs",
    "sweep:gold-coast": "node qa/gold-coast-network-sweep.mjs",
    "sweep:newcastle": "node qa/newcastle-network-sweep.mjs",
    "sweep:perth": "node qa/perth-network-sweep.mjs",
    "trim:auckland-gtfs": "node scripts/trim-auckland-gtfs.mjs",
    "trim:wellington-gtfs": "node scripts/trim-wellington-gtfs.mjs",
    "trim:amsterdam-gtfs": "node scripts/trim-amsterdam-gtfs.mjs",
    "trim:rotterdam-gtfs": "node scripts/trim-rotterdam-gtfs.mjs",
    "trim:vancouver-gtfs": "node scripts/trim-vancouver-gtfs.mjs",
    "trim:canberra-gtfs": "node scripts/trim-canberra-gtfs.mjs",
    "trim:gold-coast-gtfs": "node scripts/trim-gold-coast-gtfs.mjs",
    "trim:newcastle-gtfs": "node scripts/trim-newcastle-gtfs.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/ios": "^8.5.0",
    "@capgo/native-purchases": "^8.6.5",
    "@sentry/browser": "10.69.0",
    "@sentry/capacitor": "^4.3.0",
    "@vercel/blob": "^2.8.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1"
  }
}
