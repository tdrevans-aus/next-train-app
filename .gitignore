docs/*.xlsx

# GTFS trim output (auckland, wellington) — regenerate locally with
# scripts/trim-{city}-gtfs.mjs; never committed. See docs/jim-brief-gtfs-data-platform-scale.md.
qa/fixtures/auckland/gtfs/*.txt
qa/fixtures/wellington/gtfs/*.txt

# Root-level scratch output from ad-hoc QA/debug runs — never source
/qa-*.log
/qa-*.exit
/_out*.txt
/_ls_raw.bin
/git-out.txt
/test-*-out.txt
/test-output-*.txt
/tmp-*.js
/tmp-*.mjs

# api/package.json is a bundling stub; local npm installs regenerate a
# lockfile there we don't want to track (no other package.json in the repo
# carries one either — the root package-lock.json is the real one).
/api/package-lock.json

# Signed data-sharing agreements stay out of the repo (see docs/united-kingdom-ledger.md §1)
docs/*.pdf

# Lane-lock state now lives under the main repo's .git/ (see qa/lane-lock.mjs's header for why —
# a per-checkout file was invisible across Jim's isolated worktrees), which never needs a
# .gitignore entry of its own. These two paths are the legacy per-checkout location: kept ignored
# because older checkouts/worktrees may still have one lying around before lane-lock.mjs migrates
# and removes it on first run. It used to be committed, but the acquire only ever reached master
# after the PR it guarded had merged, so the committed copy protected nothing and every release
# needed its own PR.
docs/expansion-tracker/lane-locks.json
docs/expansion-tracker/lane-locks.json.mutex

# Agent worktrees (Claude Code isolation)
.claude/worktrees/
